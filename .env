# URL del backend GAMC para la app (Expo lee las vars con prefijo EXPO_PUBLIC_).
# Backend ya desplegado (Render) sobre Supabase. Para desarrollo local contra el
# backend en tu PC en vez del deploy, comenta esta linea y usa la IP LAN
# (mirar la que muestra Metro al arrancar: "exp://<IP>:8081"), reiniciando con
# `npx expo start -c`.
EXPO_PUBLIC_API_URL=https://api.sistec-unifranz.com/api

# Proyecto Supabase donde vive la DB del backend. Se usan directo desde la app
# solo para: (1) subir fotos/videos al bucket de Storage "evidencias" y (2) la
# Edge Function de autoservicio de contraseña — ambos flujos sin backend propio.
# La publishable key es publica por diseño (va embebida en el APK); el acceso
# queda acotado por las policies del bucket y por la Edge Function misma.
EXPO_PUBLIC_SUPABASE_URL=https://iiaclymiuyvshzotfche.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_kbJSLxvVg0lNzf9GI2x29A_RARUhxbE
