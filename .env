# URL del backend GAMC para la app (Expo lee las vars con prefijo EXPO_PUBLIC_).
# Debe ser la IP LAN de la PC donde corre `npm run dev` del backend, no localhost,
# para que el celular con Expo Go pueda alcanzarla. Si cambia la red, actualizar la IP
# (mirar la que muestra Metro al arrancar: "exp://<IP>:8081") y reiniciar con `npx expo start -c`.
EXPO_PUBLIC_API_URL=http://192.168.31.68:4001/api
